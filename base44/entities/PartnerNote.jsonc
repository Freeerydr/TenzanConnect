{
  "name": "PartnerNote",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name",
      "description": "The training partner or opponent this note is about"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "description": "Scouting notes: their game, habits, go-to moves, what worked"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}