{
  "name": "Comment",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "title": "Content",
      "description": "The reply text"
    },
    "post_id": {
      "type": "string",
      "title": "Post ID",
      "description": "The post this comment replies to"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name",
      "description": "Display name of the commenter"
    }
  },
  "required": [
    "content",
    "post_id",
    "author_name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}