{
  "name": "Technique",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name",
      "description": "The technique being tracked"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "learning",
        "drilling",
        "hitting",
        "mastered"
      ],
      "default": "learning"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "guard",
        "passing",
        "submissions",
        "escapes",
        "takedowns",
        "defense",
        "other"
      ],
      "default": "other"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}