{
  "name": "PollVote",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "title": "Post ID",
      "description": "The poll post this vote belongs to"
    },
    "option_index": {
      "type": "number",
      "title": "Option Index",
      "description": "Which poll option was chosen"
    }
  },
  "required": [
    "post_id",
    "option_index"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}