{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID",
      "description": "App user ID when the attendee is a member; blank for walk-ins/new faces not yet on the app"
    },
    "user_name": {
      "type": "string",
      "title": "User Name"
    },
    "session_date": {
      "type": "string",
      "format": "date",
      "title": "Session Date"
    },
    "class_name": {
      "type": "string",
      "title": "Class Name"
    }
  },
  "required": [
    "user_name",
    "session_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}