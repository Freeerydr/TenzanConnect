{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "title": "Event Date"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "capacity": {
      "type": "number",
      "title": "Capacity"
    }
  },
  "required": [
    "title",
    "event_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}